# ─────────────────────────────────────────────────────────────────────────────
# Predictify frontend — environment configuration
#
# Copy this file to .env.local and adjust the values for your setup:
#
#   cp .env.example .env.local
#
# .env.local is git-ignored — never commit real credentials. Variables prefixed
# with NEXT_PUBLIC_ are inlined into the browser bundle, so they must only ever
# hold public values.
#
# Every variable is optional for local development: app defaults come from
# lib/env.ts, so an empty .env.local builds and runs. Values marked "required in
# production" must be set for a real deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stellar network ──────────────────────────────────────────────────────────
# Public. Network used by the wallet kit, Horizon calls and transaction
# building (lib/config.ts, lib/stellar/transaction.ts). Allowed values:
#   testnet | mainnet
# Any other value is rejected at startup by validateEnv() in lib/env.ts.
# Default: testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ── API ──────────────────────────────────────────────────────────────────────
# Public. Base URL of the Predictify backend API, exposed as config.api.url.
# Default: http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ── Application ──────────────────────────────────────────────────────────────
# Public. Product name used in metadata and UI copy.
# Default: Predictify
NEXT_PUBLIC_APP_NAME=Predictify

# Public. Canonical origin of the deployed app. Used for sitemap.xml,
# robots.txt, metadataBase, canonical and Open Graph URLs, and JSON-LD.
# Use the real HTTPS origin in production; required there.
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional integrations ────────────────────────────────────────────────────
# Public, optional. Analytics provider id. Leave empty to disable analytics.
# Default: empty (disabled)
NEXT_PUBLIC_ANALYTICS_ID=

# Public, optional. Horizon REST endpoint override for the /api/ledger-time
# route. The server-only STELLAR_HORIZON_URL below takes precedence when set.
# Must be an absolute URL. Uncomment to override; leaving this commented makes
# the route use the network-appropriate default.
# Default (when unset): https://horizon-testnet.stellar.org
# NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Public, optional. Server-sent events endpoint for live notifications.
# Leave empty to disable the stream and keep the built-in mock fallback.
# Default: empty (disabled)
NEXT_PUBLIC_NOTIFICATION_STREAM_URL=

# ── Server-only ──────────────────────────────────────────────────────────────
# Optional, server-side only (never sent to the browser). Preferred Horizon
# endpoint override for /api/ledger-time; takes precedence over
# NEXT_PUBLIC_STELLAR_HORIZON_URL. Must be an absolute URL. Uncomment to
# override; leaving this commented makes the route use the default below.
# Default (when unset): https://horizon-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ── Framework-managed ────────────────────────────────────────────────────────
# NODE_ENV is set by Next.js itself ("development", "test" or "production").
# Do not set it in .env.local — it can break the production build and tests.
